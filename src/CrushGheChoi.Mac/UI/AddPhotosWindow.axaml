<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CrushGheChoi.UI"
        x:Class="CrushGheChoi.UI.AddPhotosWindow"
        Title="Thêm hình crush — Crush ghé chơi"
        Icon="avares://CrushGheChoi/Assets/heart.png"
        Width="1020" Height="760" MinWidth="840" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7FA" FontSize="13.5"
        DragDrop.AllowDrop="True">
    <Grid RowDefinitions="Auto,*,Auto" Margin="20,16,20,14">
        <StackPanel>
            <TextBlock Text="Thêm hình crush" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Classes="hint" FontSize="12.5" Margin="0,4,0,0"
                       Text="Chọn hình crush đã tách nền (PNG nền trong suốt), hoặc ảnh thường nếu đã cài bộ tách nền. Ảnh chỉ được xử lý trên máy này. Xong thì kiểm tra từng hình: kéo đường cắt, đặt chỗ tim bay ra, tẩy chỗ còn dính nền." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="240,14,*" Margin="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Classes="soft" Content="+ Chọn ảnh…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0" Click="OnPickPhotos" />
                <ListBox x:Name="PhotoList" SelectionChanged="OnSelectPhoto" BorderBrush="#F5C6D8" BorderThickness="1" Background="White" CornerRadius="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="ui:PhotoItem">
                            <Grid ColumnDefinitions="56,*">
                                <Border Width="52" Height="52" CornerRadius="6" Background="#F3E6EC" ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Text="{Binding Status}" Classes="hint" FontSize="11.5" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                <WrapPanel x:Name="Toolbar" IsEnabled="False">
                    <RadioButton x:Name="ModeHeart" GroupName="Tool" IsChecked="True" Content="Đặt chỗ tim bay ra" Margin="0,0,14,0" />
                    <RadioButton x:Name="ModeErase" GroupName="Tool" Content="Cục tẩy" Margin="0,0,8,0" />
                    <Slider x:Name="BrushSlider" Width="90" Minimum="6" Maximum="70" Value="22" Margin="0,0,16,0" ToolTip.Tip="Cỡ cục tẩy" />
                    <TextBlock Text="Tim bay:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <RadioButton x:Name="DriftLeft" GroupName="Drift" Content="sang trái" Margin="0,0,10,0" IsCheckedChanged="OnDriftChanged" />
                    <RadioButton x:Name="DriftRight" GroupName="Drift" Content="sang phải" Margin="0,0,14,0" IsCheckedChanged="OnDriftChanged" />
                    <Button Classes="soft" Content="Hoàn tác" Padding="10,4" Margin="0,0,6,4" Click="OnUndo" />
                    <Button Classes="soft" Content="Đặt lại" Padding="10,4" Margin="0,0,6,4" Click="OnReset" />
                    <Button Classes="soft" Content="Đổi nền" Padding="10,4" Margin="0,0,6,4" Click="OnCycleBackground" />
                </WrapPanel>

                <Border Grid.Row="1" x:Name="StageHost" Margin="0,8,0,8" CornerRadius="10" ClipToBounds="True"
                        BorderBrush="#F5C6D8" BorderThickness="1" Background="#F6ECF1" SizeChanged="OnStageHostSizeChanged">
                    <Panel>
                        <Panel x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
                            <Image x:Name="PreviewImage" Stretch="Fill" />
                            <Canvas x:Name="Overlay" Background="Transparent"
                                    PointerPressed="OnOverlayDown" PointerMoved="OnOverlayMove" PointerReleased="OnOverlayUp"
                                    PointerExited="OnOverlayLeave" PointerCaptureLost="OnOverlayLostCapture">
                                <Line x:Name="CutLine" Stroke="#E84A7F" StrokeThickness="2" StrokeDashArray="5,3" IsHitTestVisible="False" />
                                <Border x:Name="CutHandle" Background="#E84A7F" CornerRadius="9" Padding="9,2,9,3" IsHitTestVisible="False">
                                    <TextBlock Text="kéo đường này để chọn chỗ cắt" Foreground="White" FontSize="11.5" FontWeight="SemiBold" />
                                </Border>
                                <Path x:Name="HeartMarker" Width="30" Height="30" Stretch="Uniform" Fill="#E84A7F" Stroke="White" StrokeThickness="1.6" IsHitTestVisible="False"
                                      Data="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.28 2,8.5 C2,5.42 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.09 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.42 22,8.5 C22,12.28 18.6,15.36 13.45,20.04 Z" />
                                <Border x:Name="DriftArrow" Background="White" CornerRadius="9" Padding="5,0,5,2" IsHitTestVisible="False">
                                    <TextBlock x:Name="DriftArrowText" FontSize="15" FontWeight="Bold" Foreground="#E84A7F" />
                                </Border>
                                <Ellipse x:Name="BrushCursor" Stroke="White" StrokeThickness="1.5" Fill="#33E84A7F" IsVisible="False" IsHitTestVisible="False" />
                            </Canvas>
                        </Panel>

                        <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <TextBlock Text="Chưa có ảnh nào" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Classes="hint" TextAlignment="Center" Margin="0,6,0,14"
                                       Text="Kéo thả hình vào cửa sổ này, hoặc bấm nút dưới. Chọn được nhiều hình một lúc. Nên dùng PNG đã tách nền (remove.bg, Canva, hoặc chạm giữ ảnh trên iPhone)." />
                            <Button Classes="accent" Content="Chọn ảnh crush…" HorizontalAlignment="Center" Padding="20,8" Click="OnPickPhotos" />
                        </StackPanel>

                        <Border x:Name="BusyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#E6FFFFFF" CornerRadius="12" Padding="24,18" IsVisible="False">
                            <StackPanel Width="300">
                                <TextBlock x:Name="BusyText" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                                <ProgressBar IsIndeterminate="True" Height="6" Margin="0,10,0,6" />
                                <TextBlock Classes="hint" TextAlignment="Center"
                                           Text="Ảnh thường cần khoảng một phút để tách nền. Trong lúc chờ bạn cứ chỉnh các hình đã xong." />
                            </StackPanel>
                        </Border>

                        <Border x:Name="NeedsCutoutPanel" Background="#FFF7FA" IsVisible="False">
                            <Border Classes="card" MaxWidth="600" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                <StackPanel>
                                    <TextBlock Classes="title" Text="Ảnh này còn nền" FontSize="16" />
                                    <TextBlock Classes="hint" FontSize="12.5" Text="Crush cần hình đã tách nền (PNG nền trong suốt). Có hai cách:" />
                                    <TextBlock FontWeight="SemiBold" Margin="0,12,0,2" Text="1. Tự tách nền rồi thêm tệp PNG" />
                                    <TextBlock Classes="hint" FontSize="12.5"
                                               Text="Dùng remove.bg hoặc Canva; trên Mac mở ảnh bằng Preview hoặc Photos rồi chọn Remove Background / Copy Subject; trên iPhone chạm giữ vào người trong ảnh. Lưu thành PNG rồi bấm “+ Chọn ảnh…” để thêm." />
                                    <TextBlock FontWeight="SemiBold" Margin="0,12,0,2" Text="2. Cài bộ tách nền để app tự tách" />
                                    <TextBlock Classes="hint" FontSize="12.5"
                                               Text="Tự tải tệp BiRefNet-portrait (khoảng 930 MB) bằng trình duyệt, rồi chọn tệp đó. Chỉ cài một lần; sau đó ảnh thường cũng được tách ngay trên máy (mỗi ảnh khoảng một phút, cần khoảng 6 GB RAM trống)." />
                                    <TextBlock x:Name="ModelText" Classes="hint" Margin="0,8,0,0" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Classes="soft" Content="Mở trang tải" Margin="0,0,8,6" Click="OnOpenModelPage" />
                                        <Button x:Name="ImportModelButton" Classes="accent" Content="Chọn tệp đã tải…" Margin="0,0,8,6" Click="OnImportModel" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Panel>
                </Border>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="PhotoHint" Classes="hint" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="RemovePhotoButton" Grid.Column="1" Classes="soft" Content="Bỏ hình này" Padding="12,5" IsEnabled="False" Click="OnRemovePhoto" />
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
            <TextBlock x:Name="FooterText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
            <Button x:Name="SaveButton" Grid.Column="1" Classes="accent" Content="Lưu hình" MinWidth="120" HorizontalContentAlignment="Center" IsEnabled="False" Click="OnSave" />
            <Button Grid.Column="2" Classes="soft" Content="Đóng" MinWidth="80" HorizontalContentAlignment="Center" Margin="8,0,0,0" Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
