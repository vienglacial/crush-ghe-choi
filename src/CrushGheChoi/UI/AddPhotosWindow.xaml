<Window x:Class="CrushGheChoi.UI.AddPhotosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Thêm hình crush — Crush ghé chơi"
        Icon="/Assets/app.ico"
        Width="1020" Height="760" MinWidth="840" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13.5"
        Foreground="{StaticResource InkBrush}"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <Window.Resources>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H2 V2 H0Z" />
                    <GeometryDrawing Brush="#EEDFE6" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <SolidColorBrush x:Key="DarkStageBrush" Color="#1E1A22" />
        <SolidColorBrush x:Key="DesktopStageBrush" Color="#3A6EA5" />
    </Window.Resources>

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Thêm hình crush" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Hint}" FontSize="12.5" Margin="0,4,0,0"
                       Text="Chọn hình crush đã tách nền (PNG nền trong suốt), hoặc ảnh thường nếu đã cài bộ tách nền. Ảnh chỉ được xử lý trên máy này. Xong thì kiểm tra từng hình: kéo đường cắt, đặt chỗ tim bay ra, tẩy chỗ còn dính nền." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="+ Chọn ảnh…" Style="{StaticResource SoftButton}" Margin="0,8,0,0" Click="OnPickPhotos" />
                <ListBox x:Name="PhotoList" SelectionChanged="OnSelectPhoto" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource CardBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="6" Background="#F3E6EC">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel x:Name="Toolbar" IsEnabled="False">
                    <RadioButton x:Name="ModeHeart" GroupName="Tool" IsChecked="True" Checked="OnToolChanged" Content="Đặt chỗ tim bay ra" />
                    <RadioButton x:Name="ModeErase" GroupName="Tool" Checked="OnToolChanged" Content="Cục tẩy" />
                    <Slider x:Name="BrushSlider" Width="90" Minimum="6" Maximum="70" Value="22" Margin="0,0,16,0" ToolTip="Cỡ cục tẩy" ValueChanged="OnBrushChanged" />
                    <TextBlock Text="Tim bay:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <RadioButton x:Name="DriftLeft" GroupName="Drift" Content="sang trái" Checked="OnDriftChanged" />
                    <RadioButton x:Name="DriftRight" GroupName="Drift" Content="sang phải" Checked="OnDriftChanged" />
                    <Button Content="Hoàn tác" Style="{StaticResource SoftButton}" Padding="10,4" Margin="0,0,6,4" Click="OnUndo" />
                    <Button Content="Đặt lại" Style="{StaticResource SoftButton}" Padding="10,4" Margin="0,0,6,4" Click="OnReset" />
                    <Button Content="Đổi nền" Style="{StaticResource SoftButton}" Padding="10,4" Margin="0,0,6,4" Click="OnCycleBackground" />
                </WrapPanel>

                <Border Grid.Row="1" x:Name="StageHost" Margin="0,8,0,8" CornerRadius="10" ClipToBounds="True"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        Background="{StaticResource CheckerBrush}" SizeChanged="OnStageHostSizeChanged">
                    <Grid>
                        <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Canvas x:Name="Overlay" Background="Transparent"
                                    MouseLeftButtonDown="OnOverlayDown" MouseMove="OnOverlayMove" MouseLeftButtonUp="OnOverlayUp"
                                    MouseLeave="OnOverlayLeave" LostMouseCapture="OnOverlayLostCapture">
                                <Line x:Name="CutLine" Stroke="#E84A7F" StrokeThickness="2" StrokeDashArray="5 3" IsHitTestVisible="False" />
                                <Border x:Name="CutHandle" Background="#E84A7F" CornerRadius="9" Padding="9,2,9,3" IsHitTestVisible="False">
                                    <TextBlock Text="kéo đường này để chọn chỗ cắt" Foreground="White" FontSize="11.5" FontWeight="SemiBold" />
                                </Border>
                                <Grid x:Name="HeartMarker" IsHitTestVisible="False">
                                    <Path Width="30" Height="30" Stretch="Uniform" Fill="#E84A7F" Stroke="White" StrokeThickness="1.6"
                                          Data="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.28 2,8.5 C2,5.42 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.09 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.42 22,8.5 C22,12.28 18.6,15.36 13.45,20.04 Z" />
                                </Grid>
                                <TextBlock x:Name="DriftArrow" FontSize="20" FontWeight="Bold" Foreground="#E84A7F" IsHitTestVisible="False">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="1" Color="White" />
                                    </TextBlock.Effect>
                                </TextBlock>
                                <Ellipse x:Name="BrushCursor" Stroke="White" StrokeThickness="1.5" Fill="#33E84A7F" Visibility="Collapsed" IsHitTestVisible="False">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.9" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Canvas>
                        </Grid>

                        <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="Chưa có ảnh nào" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,6,0,14"
                                       Text="Kéo thả hình vào cửa sổ này, hoặc bấm nút dưới. Chọn được nhiều hình một lúc. Nên dùng PNG đã tách nền (remove.bg, Canva, Paint trên Windows 11…)." />
                            <Button Content="Chọn ảnh crush…" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Padding="20,8" Click="OnPickPhotos" />
                        </StackPanel>

                        <Border x:Name="BusyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#E6FFFFFF" CornerRadius="12" Padding="24,18" Visibility="Collapsed">
                            <StackPanel Width="300">
                                <TextBlock x:Name="BusyText" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                                <ProgressBar IsIndeterminate="True" Height="6" Margin="0,10,0,6" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Style="{StaticResource Hint}" TextAlignment="Center"
                                           Text="Ảnh thường cần khoảng một phút để tách nền. Trong lúc chờ bạn cứ chỉnh các hình đã xong." />
                            </StackPanel>
                        </Border>

                        <Border x:Name="NeedsCutoutPanel" Background="{StaticResource PageBrush}" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}" MaxWidth="600" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                <StackPanel>
                                    <TextBlock Text="Ảnh này còn nền" Style="{StaticResource CardTitle}" FontSize="16" />
                                    <TextBlock Style="{StaticResource Hint}" FontSize="12.5" Text="Crush cần hình đã tách nền (PNG nền trong suốt). Có hai cách:" />
                                    <TextBlock FontWeight="SemiBold" Margin="0,12,0,2" Text="1. Tự tách nền rồi thêm tệp PNG" />
                                    <TextBlock Style="{StaticResource Hint}" FontSize="12.5"
                                               Text="Dùng remove.bg hoặc Canva; Paint trên Windows 11 (nút Remove background); trên iPhone chạm giữ vào người trong ảnh rồi chọn Chia sẻ. Lưu thành PNG rồi bấm “+ Chọn ảnh…” để thêm." />
                                    <TextBlock FontWeight="SemiBold" Margin="0,12,0,2" Text="2. Cài bộ tách nền để app tự tách" />
                                    <TextBlock Style="{StaticResource Hint}" FontSize="12.5"
                                               Text="Tự tải tệp BiRefNet-portrait (khoảng 930 MB) bằng trình duyệt, rồi chọn tệp đó. Chỉ cài một lần; sau đó ảnh thường cũng được tách ngay trên máy (mỗi ảnh khoảng một phút, cần khoảng 6 GB RAM trống)." />
                                    <TextBlock x:Name="ModelText" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="Mở trang tải" Style="{StaticResource SoftButton}" Margin="0,0,8,6" Click="OnOpenModelPage" />
                                        <Button x:Name="ImportModelButton" Content="Chọn tệp đã tải…" Style="{StaticResource AccentButton}" Margin="0,0,8,6" Click="OnImportModel" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PhotoHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="RemovePhotoButton" Grid.Column="1" Content="Bỏ hình này" Style="{StaticResource SoftButton}" Padding="12,5" IsEnabled="False" Click="OnRemovePhoto" />
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
            <Button x:Name="SaveButton" Grid.Column="1" Content="Lưu hình" Style="{StaticResource AccentButton}" MinWidth="120" IsEnabled="False" Click="OnSave" />
            <Button Grid.Column="2" Content="Đóng" Style="{StaticResource SoftButton}" MinWidth="80" Margin="8,0,0,0" IsCancel="True" Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
