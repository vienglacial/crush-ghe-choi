<Window x:Class="CrushGheChoi.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Chào bạn — Crush ghé chơi"
        Icon="/Assets/app.ico"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13.5"
        Foreground="{StaticResource InkBrush}"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="26,22,26,20">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/heart-256.png" Width="40" Height="40" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Chào bạn, crush ghé chơi nè!" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,12,0,16"
                   Text="App nằm ở khay hệ thống, cạnh đồng hồ. Thỉnh thoảng crush ghé lên màn hình (mỗi lần một hình, một chỗ), chào bạn, hun gió thả tim rồi tự đi. Crush không giành bàn phím và chuột bấm xuyên qua được, bạn cứ làm việc bình thường." />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="1. Thêm hình crush của bạn" Style="{StaticResource CardTitle}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Chọn vài hình crush đã tách nền (PNG nền trong suốt, làm bằng remove.bg, Canva hay Paint trên Windows 11). Ảnh thường cũng được nếu bạn cài thêm bộ tách nền. Chưa có hình thì crush tạm là một trái tim dễ thương." />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Chọn ảnh crush…" Style="{StaticResource AccentButton}" Click="OnAddPhotos" />
                    <TextBlock x:Name="PhotoCountText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="2. Xem thử" Style="{StaticResource CardTitle}" />
                <Button Content="Cho tui xem thử" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Padding="20,8" Click="OnPreview" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="3. Kích thước và vị trí xuất hiện" Style="{StaticResource CardTitle}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SizeSmall" Content="Nhỏ" GroupName="Size" />
                    <RadioButton x:Name="SizeMedium" Content="Vừa" GroupName="Size" IsChecked="True" />
                    <RadioButton x:Name="SizeLarge" Content="Lớn" GroupName="Size" />
                </StackPanel>
                <WrapPanel Margin="0,4,0,0">
                    <RadioButton x:Name="PlaceRandom" Content="Ngẫu nhiên khắp màn hình" GroupName="Corner" IsChecked="True" />
                    <RadioButton x:Name="CornerLeft" Content="Góc trái dưới" GroupName="Corner" />
                    <RadioButton x:Name="CornerRight" Content="Góc phải dưới" GroupName="Corner" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="4. Lịch ghé chơi" Style="{StaticResource CardTitle}" />
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="AutoBox" IsChecked="True" Content="Tự động ghé ngẫu nhiên mỗi" />
                    <ComboBox x:Name="IntervalBox" MinWidth="120" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Trừ giờ yên lặng 22:30–08:30." />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="Mọi thứ chỉnh lại được trong Cài đặt (chuột phải vào trái tim ở khay hệ thống)." />
            </StackPanel>
        </Border>

        <TextBlock x:Name="MessageText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
        <Button Content="Xong, thu xuống khay" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Padding="20,8" IsDefault="True" Click="OnDone" />
    </StackPanel>
</Window>
