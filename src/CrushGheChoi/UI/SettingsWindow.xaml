<Window x:Class="CrushGheChoi.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Crush ghé chơi — Cài đặt"
        Icon="/Assets/app.ico"
        Width="640" Height="720" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13.5"
        Foreground="{StaticResource InkBrush}"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/heart-256.png" Width="34" Height="34" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Crush ghé chơi" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" FontSize="12.5" />
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,14,0,0">
            <!-- ========== Crush ========== -->
            <TabItem Header="Crush">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Hình crush" Style="{StaticResource CardTitle}" />
                                    <Button Content="+ Thêm hình…" Style="{StaticResource AccentButton}" Padding="14,5" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnAddPhotos" />
                                </Grid>
                                <TextBlock x:Name="PhotosHint" Style="{StaticResource Hint}" Margin="0,2,0,8" />
                                <WrapPanel x:Name="PhotoStrip" />
                                <Expander Header="Nâng cao: dùng bộ hình làm sẵn trong thư mục khác" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12.5">
                                    <StackPanel Margin="0,8,0,0">
                                        <RadioButton x:Name="BuiltInSetRadio" Content="Hình crush của tôi (ở trên)" GroupName="Set" Checked="OnSetChoiceChanged" />
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <RadioButton x:Name="CustomSetRadio" Content="Thư mục khác:" GroupName="Set" Checked="OnSetChoiceChanged" />
                                            <TextBox x:Name="SetPathBox" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,0" />
                                            <Button Grid.Column="2" Content="Chọn…" Style="{StaticResource SoftButton}" Padding="12,5" Click="OnBrowseSet" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                   Text="Thư mục có manifest.json và các hình PNG nền trong suốt (xem README). Đổi ở đây cần bấm Lưu." />
                                        <TextBlock x:Name="SetInfoText" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Kích thước" Style="{StaticResource CardTitle}" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SizeSmall" Content="Nhỏ" GroupName="Size" Checked="OnSizePreset" />
                                    <RadioButton x:Name="SizeMedium" Content="Vừa" GroupName="Size" Checked="OnSizePreset" />
                                    <RadioButton x:Name="SizeLarge" Content="Lớn" GroupName="Size" Checked="OnSizePreset" />
                                    <RadioButton x:Name="SizeCustom" Content="Tùy chỉnh" GroupName="Size" IsHitTestVisible="False" Focusable="False" />
                                </StackPanel>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SizeSlider" Minimum="160" Maximum="560" SmallChange="10" LargeChange="40" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OnSizeSlider" />
                                    <TextBlock x:Name="SizeValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Trái tim" Style="{StaticResource CardTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Màu" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="PaletteBox" Grid.Column="1">
                                        <ComboBoxItem Content="Hồng và đỏ" />
                                        <ComboBoxItem Content="Tím" />
                                        <ComboBoxItem Content="Pastel" />
                                    </ComboBox>
                                    <TextBlock Grid.Column="2" Text="Số tim mỗi lần hun" VerticalAlignment="Center" Margin="20,0,8,0" />
                                    <Slider x:Name="HeartSlider" Grid.Column="3" Minimum="1" Maximum="8" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnHeartSlider" />
                                    <TextBlock x:Name="HeartValue" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <CheckBox x:Name="ReducedMotionBox" Margin="0,10,0,0">
                                    <TextBlock TextWrapping="Wrap" Text="Chuyển động nhẹ — hiện bằng chuyển mờ, ít tim, không nhún" />
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Xem thử" Style="{StaticResource CardTitle}" />
                                <WrapPanel>
                                    <Button Content="Xem thử chào" Style="{StaticResource AccentButton}" Margin="0,0,8,6" Click="OnPreviewGreet" />
                                    <Button Content="Xem thử hun" Style="{StaticResource AccentButton}" Margin="0,0,8,6" Click="OnPreviewKiss" />
                                    <Button Content="Chào rồi hun" Style="{StaticResource SoftButton}" Margin="0,0,8,6" Click="OnPreviewBoth" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="Xem thử dùng các lựa chọn đang chỉnh, kể cả khi chưa bấm Lưu và trong giờ yên lặng." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== Ghé chơi ========== -->
            <TabItem Header="Ghé chơi">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="AutoVisitBox" Content="Tự động ghé chơi" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="24,8,0,0">
                                    <TextBlock Text="Mỗi lần cách nhau từ" VerticalAlignment="Center" />
                                    <TextBox x:Name="MinIntervalBox" Width="52" Margin="8,0" HorizontalContentAlignment="Center" />
                                    <TextBlock Text="đến" VerticalAlignment="Center" />
                                    <TextBox x:Name="MaxIntervalBox" Width="52" Margin="8,0" HorizontalContentAlignment="Center" />
                                    <TextBlock Text="phút" VerticalAlignment="Center" />
                                </StackPanel>
                                <WrapPanel x:Name="IntervalPresetPanel" Margin="24,8,0,0" />
                                <TextBlock Style="{StaticResource Hint}" Margin="24,2,0,0"
                                           Text="Mỗi lần crush ghé vào một lúc ngẫu nhiên trong khoảng này (ít nhất 1 phút). Hai lần tự ghé không bao giờ gần nhau hơn số phút “từ”." />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <CheckBox x:Name="QuietBox" Content="Giờ yên lặng từ" />
                                    <TextBox x:Name="QuietStartBox" Width="62" Margin="8,0" HorizontalContentAlignment="Center" />
                                    <TextBlock Text="đến" VerticalAlignment="Center" />
                                    <TextBox x:Name="QuietEndBox" Width="62" Margin="8,0" HorizontalContentAlignment="Center" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="24,4,0,0"
                                           Text="Theo giờ máy, nhập dạng 22:30. Khoảng có thể vắt qua nửa đêm." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ScheduleText" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button x:Name="ResumeButton" Grid.Column="1" Content="Tiếp tục ngay" Style="{StaticResource SoftButton}" Padding="12,5" Click="OnResume" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Câu chào (mỗi dòng một câu)" Style="{StaticResource CardTitle}" />
                                    <Button Content="Dùng lại câu mặc định" Style="{StaticResource SoftButton}" Padding="10,3" FontSize="12"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnResetGreetings" />
                                </Grid>
                                <TextBox x:Name="GreetingsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="170"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Mỗi lần ghé bốc một câu; dùng hết lượt mới lặp lại và không nói lại ngay câu vừa nói." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== Màn hình ========== -->
            <TabItem Header="Màn hình">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Màn hình hiển thị" Style="{StaticResource CardTitle}" />
                                <ComboBox x:Name="MonitorBox" HorizontalAlignment="Left" MinWidth="320" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Nếu màn hình đã chọn bị rút ra, crush sẽ ghé ở màn hình chính." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Vị trí xuất hiện" Style="{StaticResource CardTitle}" />
                                <WrapPanel>
                                    <RadioButton x:Name="PlaceRandom" Content="Ngẫu nhiên khắp màn hình" GroupName="Corner" />
                                    <RadioButton x:Name="CornerLeft" Content="Góc trái dưới" GroupName="Corner" />
                                    <RadioButton x:Name="CornerRight" Content="Góc phải dưới" GroupName="Corner" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Ngẫu nhiên: mỗi lần ghé một chỗ khác, crush hiện mờ dần rồi nhích lên. Ở góc: crush nhô lên từ mép dưới." />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Cách mép ngang" VerticalAlignment="Center" />
                                    <TextBox x:Name="OffsetXBox" Width="56" Margin="8,0" HorizontalContentAlignment="Center" />
                                    <TextBlock Text="cách mép dưới" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBox x:Name="OffsetYBox" Width="56" Margin="8,0" HorizontalContentAlignment="Center" />
                                    <TextBlock Text="(khi ở góc, đơn vị giao diện)" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Content="Chỉnh vị trí bằng cách kéo…" Style="{StaticResource SoftButton}" HorizontalAlignment="Left"
                                        Margin="0,12,0,0" Click="OnAdjustPosition" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Chế độ hiển thị" Style="{StaticResource CardTitle}" />
                                <RadioButton x:Name="ModeVisit" GroupName="Mode">
                                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Ghé chơi" /><Run Text=" — hiện trên cửa sổ đang làm việc vài giây rồi đi (mặc định)" /></TextBlock>
                                </RadioButton>
                                <RadioButton x:Name="ModeDesktop" GroupName="Mode">
                                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Chỉ trên desktop" /><Run Text=" — chỉ xuất hiện khi desktop đang ở phía trước" /></TextBlock>
                                </RadioButton>
                                <CheckBox x:Name="DeferFullScreenBox" Margin="0,10,0,0">
                                    <TextBlock TextWrapping="Wrap" Text="Hoãn lần ghé tự động khi có ứng dụng toàn màn hình (trình chiếu, game, video)" />
                                </CheckBox>
                                <TextBlock Text="Vẫn cho ghé khi đang dùng các app này dù phủ kín màn hình (tên tiến trình, cách nhau dấu phẩy):"
                                           Style="{StaticResource Hint}" Margin="24,4,0,4" />
                                <TextBox x:Name="AllowedAppsBox" Margin="24,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== Ứng dụng ========== -->
            <TabItem Header="Ứng dụng">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="SoundBox" Content="Phát tiếng chuông nhẹ khi crush ghé" />
                                <CheckBox x:Name="StartupBox" Content="Chạy cùng Windows" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Sao lưu và khôi phục" Style="{StaticResource CardTitle}" />
                                <WrapPanel>
                                    <Button Content="Sao lưu cấu hình…" Style="{StaticResource SoftButton}" Margin="0,0,8,6" Click="OnExport" />
                                    <Button Content="Khôi phục từ bản sao…" Style="{StaticResource SoftButton}" Margin="0,0,8,6" Click="OnImport" />
                                    <Button Content="Mở thư mục dữ liệu" Style="{StaticResource SoftButton}" Margin="0,0,8,6" Click="OnOpenData" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Khôi phục sẽ nạp cài đặt từ bản sao vào cửa sổ này; bấm Lưu để áp dụng." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="AboutText" Style="{StaticResource Hint}" FontSize="12.5" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" Margin="0,0,12,0" />
            <Button Grid.Column="1" Content="Lưu" Style="{StaticResource AccentButton}" MinWidth="96" IsDefault="True" Click="OnSave" />
            <Button Grid.Column="2" Content="Hủy" Style="{StaticResource SoftButton}" MinWidth="80" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
        </Grid>
    </Grid>
</Window>
