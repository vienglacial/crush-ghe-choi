<Window x:Class="CrushGheChoi.Overlay.DesktopOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CrushGheChoi.Overlay"
        x:ClassModifier="internal"
        Title="Crush ghé chơi"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        UseLayoutRounding="True"
        Width="400"
        Height="400">
    <Canvas x:Name="Root" ClipToBounds="True">

        <!-- Khung kéo, chỉ hiện ở chế độ "Chỉnh vị trí". -->
        <Rectangle x:Name="AdjustOutline"
                   Visibility="Collapsed"
                   RadiusX="16" RadiusY="16"
                   Stroke="#E84A7F" StrokeThickness="2" StrokeDashArray="4 3"
                   Fill="#26FF4F8B"
                   Cursor="SizeAll" />

        <Image x:Name="CrushImage"
               Stretch="Fill"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality"
               RenderTransformOrigin="0.5,1">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BodyScale" />
                    <RotateTransform x:Name="BodyRotate" />
                    <TranslateTransform x:Name="BodyTranslate" />
                </TransformGroup>
            </Image.RenderTransform>
            <!-- Mép cắt nửa người mờ dần cho mềm. -->
            <Image.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Black" Offset="0" />
                    <GradientStop Color="Black" Offset="0.9" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Image.OpacityMask>
        </Image>

        <local:HeartLayer x:Name="Hearts">
            <local:HeartLayer.Effect>
                <DropShadowEffect Color="#FF6FA8" BlurRadius="10" ShadowDepth="0" Opacity="0.55" />
            </local:HeartLayer.Effect>
        </local:HeartLayer>

        <Grid x:Name="Bubble" Opacity="0" IsHitTestVisible="False">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="BubbleScale" />
            </Grid.RenderTransform>
            <Grid.Effect>
                <DropShadowEffect Color="#5A2340" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.28" />
            </Grid.Effect>
            <Border Background="#FFFFFCFD"
                    BorderBrush="#F5A3C0"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="14,9,14,10"
                    MaxWidth="240"
                    Margin="0,0,0,13">
                <TextBlock x:Name="BubbleText"
                           TextWrapping="Wrap"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="14.5"
                           Foreground="#5A2340"
                           TextOptions.TextFormattingMode="Display" />
            </Border>
            <Path x:Name="BubbleTail"
                  Data="M 0,0 L 22,14.5 L 16,0"
                  Fill="#FFFFFCFD"
                  Stroke="#F5A3C0"
                  StrokeThickness="1.5"
                  StrokeLineJoin="Round"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Right"
                  Margin="0,0,22,0"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <ScaleTransform x:Name="BubbleTailFlip" />
                </Path.RenderTransform>
            </Path>
        </Grid>

        <Border x:Name="AdjustPanel"
                Visibility="Collapsed"
                Background="#FFFFFCFD"
                BorderBrush="#F5A3C0"
                BorderThickness="1.5"
                CornerRadius="14"
                Padding="14,10">
            <Border.Effect>
                <DropShadowEffect Color="#5A2340" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.25" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Kéo tui tới chỗ bạn muốn nha"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="14" FontWeight="SemiBold" Foreground="#5A2340" />
                <TextBlock Text="Enter để lưu, Esc để hủy"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12" Foreground="#8A6A7B" Margin="0,2,0,8" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AdjustSaveButton" Content="Lưu vị trí" Style="{StaticResource AccentButton}" Click="OnAdjustSave" />
                    <Button Content="Hủy" Style="{StaticResource SoftButton}" Margin="8,0,0,0" Click="OnAdjustCancel" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
